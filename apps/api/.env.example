NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:5173
STORAGE_DIR=storage

YTDLP_PATH=yt-dlp
MAX_SOURCE_SECONDS=900
SOURCE_TIMEOUT_MS=120000

# Optional: Google Gemini API key for AI Visual Director (falls back to heuristic director when omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
# VISUAL_DIRECTOR_PROVIDER=auto